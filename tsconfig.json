{
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "build",
                    "dist",
                    "**/*.test.ts"
                ],
    "compilerOptions":  {
                            "target":  "ES2020",
                            "noEmit":  true,
                            "jsx":  "react-jsx",
                            "lib":  [
                                        "esnext",
                                        "dom",
                                        "dom.iterable"
                                    ],
                            "module":  "ESNext",
                            "resolveJsonModule":  true,
                            "allowImportingTsExtensions":  true,
                            "isolatedModules":  true,
                            "strict":  true,
                            "skipLibCheck":  true,
                            "moduleResolution":  "bundler",
                            "baseUrl":  ".",
                            "types":  [
                                          "node",
                                          "vite/client"
                                      ],
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      }
                        }
}
